{
  "name": "dsh-pocket-todo",
  "version": "0.2.3",
  "description": "Native DSH screenshot-to-todo assistant with auditable Android and WeChat launch targets",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.mjs",
    "./remote": "./lib/remote.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "android/PocketLauncher.kt",
    "cordis.patch.yml",
    "README.md",
    "targets.example.json",
    "android/AndroidManifest.fragment.xml"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "pack:kit": "npm run build && node scripts/pack.mjs"
  },
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1 || ^3.18.5-alpha.1",
    "@deepseek-ai/dsh-agent": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-alpha.1",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "license": "MIT"
}
